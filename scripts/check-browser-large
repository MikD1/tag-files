#!/usr/bin/env python3
"""Opt-in actual-browser upload probe; all large files stay below the project."""
import hashlib
import http.client
import http.server
import json
import os
import pathlib
import secrets
import signal
import shutil
import socket
import struct
import subprocess
import tempfile
import threading
import time
import urllib.parse


ROOT = pathlib.Path(__file__).resolve().parent.parent
MIB = 1024 * 1024
GIB = 1024 * MIB


def command(*args, **kwargs):
    return subprocess.check_output(args, text=True, **kwargs).strip()


def port():
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        return listener.getsockname()[1]


class ProbeProxy(http.server.ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, upstream):
        super().__init__(("127.0.0.1", 0), ProxyHandler)
        self.upstream = upstream
        self.guard = threading.Lock()
        self.active = 0
        self.maximum = 0
        self.paced = False
        self.parts = []

    def metrics(self):
        with self.guard:
            return {"active": self.active, "maximum": self.maximum, "parts": list(self.parts)}


class ProxyHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *_args):
        pass

    def do_GET(self):
        self.forward()

    do_POST = do_PUT = do_DELETE = do_PATCH = do_HEAD = do_GET

    def forward(self):
        if self.path == "/__browser-large/metrics":
            body = json.dumps(self.server.metrics()).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        part = self.command == "PUT" and "/upload-sessions/" in self.path and "/parts/" in self.path
        length = int(self.headers.get("Content-Length", "0"))
        record = None
        if part:
            with self.server.guard:
                pace = not self.server.paced
                self.server.paced = True
                self.server.active += 1
                self.server.maximum = max(self.server.maximum, self.server.active)
            record = {"path": self.path, "length": length, "bytes": 0, "status": 0,
                      "generation": self.headers.get("X-Upload-Generation"),
                      "digest": self.headers.get("X-Part-SHA256"),
                      "start": time.monotonic(), "paced": pace}
        upstream = http.client.HTTPConnection("127.0.0.1", self.server.upstream, timeout=600)
        try:
            upstream.putrequest(self.command, self.path, skip_host=True, skip_accept_encoding=True)
            for name, value in self.headers.items():
                if name.lower() not in ("connection", "transfer-encoding"):
                    upstream.putheader(name, value)
            upstream.putheader("Connection", "close")
            upstream.endheaders()
            remaining = length
            started = time.monotonic()
            # A bounded 64KiB stream. Only the first actual part is paced,
            # without interception or reconstruction of a browser Blob.
            while remaining:
                block = self.rfile.read(min(64 * 1024, remaining))
                if not block:
                    raise ConnectionError("browser body ended before Content-Length")
                upstream.send(block)
                remaining -= len(block)
                if record:
                    record["bytes"] += len(block)
                    if record["paced"]:
                        delay = record["bytes"] / (8 * MIB) - (time.monotonic() - started)
                        if delay > 0:
                            time.sleep(delay)
            response = upstream.getresponse()
            if record:
                record["status"] = response.status
            self.send_response(response.status)
            for name, value in response.getheaders():
                if name.lower() not in ("connection", "transfer-encoding"):
                    self.send_header(name, value)
            self.send_header("Connection", "close")
            self.end_headers()
            while block := response.read(64 * 1024):
                self.wfile.write(block)
            self.close_connection = True
        except (OSError, http.client.HTTPException) as error:
            if record:
                record["error"] = type(error).__name__
            self.close_connection = True
        finally:
            upstream.close()
            if record:
                record["end"] = time.monotonic()
                with self.server.guard:
                    self.server.active -= 1
                    self.server.parts.append(record)


def fingerprint(path):
    digest = hashlib.sha256()
    with path.open("rb") as source:
        while block := source.read(MIB):
            digest.update(block)
    return digest.hexdigest()


def main():
    app_image = command("docker", "image", "inspect", "--format", "{{.Id}}", os.environ["TAG_FILES_BROWSER_APP_IMAGE"])
    storage_image = command("docker", "image", "inspect", "--format", "{{.Id}}", os.environ["TAG_FILES_BROWSER_STORAGE_IMAGE"])
    maximum = int(os.environ.get("TAG_FILES_BROWSER_LARGE_BYTES", 20 * GIB))
    companion = int(os.environ.get("TAG_FILES_BROWSER_SECOND_BYTES", 256 * MIB))
    if not (32 * MIB <= maximum <= 20 * GIB and 32 * MIB <= companion <= 256 * MIB):
        raise ValueError("fixture bounds must be 32MiB..20GiB and 32MiB..256MiB")
    with tempfile.TemporaryDirectory(prefix=".large-upload.browser.", dir=ROOT) as temporary:
        work = pathlib.Path(temporary)
        reuse = os.environ.get("TAG_FILES_BROWSER_REUSE_MANIFEST")
        if reuse:
            cached = pathlib.Path(reuse).resolve(strict=True)
            if not cached.is_relative_to(ROOT) or not cached.parent.name.startswith(".large-upload.browser-cache."):
                raise ValueError("reuse only accepts this probe's ignored project fixture cache")
            manifest = json.loads(cached.read_text())
            if manifest["maximum"] != maximum or manifest["companion"] != companion:
                raise ValueError("cached fixture lengths differ from the requested exact sizes")
            for name in ("video", "unsupported"):
                path = pathlib.Path(manifest[name]).resolve(strict=True)
                if not path.is_relative_to(cached.parent):
                    raise ValueError("cached input must remain inside its owned fixture cache")
                info = path.stat()
                actual = {"size": info.st_size, "mtimeNs": info.st_mtime_ns, "device": info.st_dev, "inode": info.st_ino}
                if actual != manifest["identities"][name]:
                    raise ValueError("cached input changed; prepare and independently hash a fresh fixture")
            video, unsupported = pathlib.Path(manifest["video"]), pathlib.Path(manifest["unsupported"])
            print("Reusing unchanged sparse inputs and completed independent SHA256:", cached, flush=True)
        else:
            fixtures = work / "files"
            fixtures.mkdir()
            video = fixtures / "padded-video.mp4"
            unsupported = fixtures / "unsupported.mp4"
            subprocess.run(["ffmpeg", "-hide_banner", "-v", "error", "-nostdin", "-f", "lavfi", "-i",
                            "testsrc2=size=128x80:rate=15:duration=1.5", "-c:v", "libx264", "-threads", "2",
                            "-pix_fmt", "yuv420p", "-movflags", "+faststart", str(video)], check=True)
            useful_bytes = video.stat().st_size
            with video.open("r+b") as padded:
                padded.seek(0, os.SEEK_END)
                padded.write(struct.pack(">I4sQ", 1, b"free", maximum - useful_bytes))
                padded.truncate(maximum)
            with unsupported.open("wb") as invalid:
                invalid.write(b"not a media container\n")
                invalid.truncate(companion)
            manifest = {"video": str(video), "unsupported": str(unsupported), "maximum": maximum,
                        "companion": companion, "usefulVideoBytes": useful_bytes,
                        "videoSHA256": fingerprint(video), "unsupportedSHA256": fingerprint(unsupported)}
            for path in (video, unsupported):
                print(f"OS file {path.name}: length={path.stat().st_size}, allocated={path.stat().st_blocks * 512}", flush=True)
            print("Fixture has a tiny valid MP4 plus a sparse extended-size free atom, not 20GiB useful video.", flush=True)
            (work / "manifest.json").write_text(json.dumps(manifest))
        (work / "manifest.json").write_text(json.dumps(manifest))
        if os.environ.get("TAG_FILES_BROWSER_VALIDATE_ONLY") == "1":
            print("Fixture metadata validated; no services or browser uploads started", flush=True)
            return
        shutil.copyfile(ROOT / "compose.yml", work / "compose.yml")
        (work / "secrets").mkdir(mode=0o700)
        for name in ("s3_access_key", "s3_secret_key"):
            path = work / "secrets" / name
            path.write_text(secrets.token_hex(32) + "\n")
            path.chmod(0o444)
        app_port = port()
        env = {**os.environ, "TAG_FILES_APP_IMAGE": app_image, "TAG_FILES_STORAGE_IMAGE": storage_image,
               "TAG_FILES_PORT": str(app_port)}
        project = "tag-files-browser-large-" + secrets.token_hex(6)
        compose = ["docker", "compose", "-p", project, "-f", str(work / "compose.yml")]
        proxy = None
        try:
            subprocess.run([*compose, "up", "-d", "--pull", "never", "--wait", "--wait-timeout", "180"], env=env, check=True)
            app_container = command(*compose, "ps", "-q", "app", env=env)
            storage_container = command(*compose, "ps", "-q", "storage", env=env)
            available = int(command("docker", "exec", storage_container, "df", "-Pk", "/data").splitlines()[-1].split()[3]) * 1024
            if int(available) < (100 * GIB if maximum == 20 * GIB else 4 * GIB):
                raise RuntimeError("insufficient disposable S3 headroom for input/candidates/reservations")
            app_pid = command("docker", "inspect", "--format", "{{.State.Pid}}", app_container)
            proxy = ProbeProxy(app_port)
            thread = threading.Thread(target=proxy.serve_forever, daemon=True)
            thread.start()
            test_env = {**env, "TAG_FILES_BROWSER_LARGE_ORIGIN": f"http://127.0.0.1:{proxy.server_port}",
                        "TAG_FILES_BROWSER_LARGE_MANIFEST": str(work / "manifest.json"),
                        "TAG_FILES_BROWSER_APP_PID": app_pid,
                        "TAG_FILES_BROWSER_APP_ID": app_image, "TAG_FILES_BROWSER_STORAGE_ID": storage_image}
            print(f"Pinned actual SPA/app={app_image}, S3={storage_image}, origin={test_env['TAG_FILES_BROWSER_LARGE_ORIGIN']}", flush=True)
            engines = os.environ.get("TAG_FILES_BROWSER_ENGINES", "chromium,webkit").split(",")
            for engine in engines:
                if engine not in ("chromium", "webkit"):
                    raise ValueError("only chromium and webkit are supported")
                with proxy.guard:
                    if proxy.active:
                        raise RuntimeError("previous browser still has an active part")
                    proxy.paced, proxy.maximum, proxy.parts = False, 0, []
                runner = subprocess.Popen(["npm", "exec", "playwright", "test", "--", "--config", "e2e/large/config.ts", "--project", engine],
                                          cwd=ROOT / "web", env={**test_env, "TAG_FILES_BROWSER_ENGINE": engine}, start_new_session=True)
                try:
                    status = runner.wait()
                except BaseException:
                    try:
                        os.killpg(runner.pid, signal.SIGINT)
                        runner.wait(timeout=15)
                    except (ProcessLookupError, subprocess.TimeoutExpired):
                        if runner.poll() is None:
                            os.killpg(runner.pid, signal.SIGTERM)
                            runner.wait(timeout=15)
                    raise
                if status:
                    raise subprocess.CalledProcessError(status, runner.args)
        except BaseException:
            subprocess.run([*compose, "logs", "--no-color", "--tail", "60"], env=env, check=False)
            raise
        finally:
            if proxy:
                proxy.shutdown()
                proxy.server_close()
            subprocess.run([*compose, "down", "--volumes", "--remove-orphans", "--timeout", "120"], env=env, check=True)


if __name__ == "__main__":
    main()
