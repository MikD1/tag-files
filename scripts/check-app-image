#!/usr/bin/env bash
set -euo pipefail
project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
check_app_image=${TAG_FILES_APP_TEST_IMAGE:-tag-files-app:local}
check_storage_image=${TAG_FILES_STORAGE_TEST_IMAGE:-tag-files-storage:local-check}
if [[ ${TAG_FILES_SKIP_IMAGE_BUILD:-0} != 1 ]]; then
  docker build --progress=plain --target app --build-arg "VERSION=${TAG_FILES_VERSION:-development}" -f "$project_root/deploy/app/Dockerfile" -t "$check_app_image" "$project_root"
  docker build --progress=plain -f "$project_root/deploy/storage/Dockerfile" -t "$check_storage_image" "$project_root"
fi
export TAG_FILES_APP_IMAGE=$(docker image inspect --format '{{.Id}}' "$check_app_image")
export TAG_FILES_STORAGE_IMAGE=$(docker image inspect --format '{{.Id}}' "$check_storage_image")
check_root=$(mktemp -d)
check_project="tag-files-check-$(openssl rand -hex 6)"
export TAG_FILES_PORT=$(python3 - <<'PY'
import socket
with socket.socket() as s:
    s.bind(('127.0.0.1',0))
    print(s.getsockname()[1])
PY
)
cleanup() {
  status=$?
  if [[ $status != 0 ]]; then docker compose -p "$check_project" -f "$check_root/compose.yml" logs --no-color >&2 || true; fi
  docker compose -p "$check_project" -f "$check_root/compose.yml" down --volumes --remove-orphans --timeout 120 || true
  rm -rf -- "$check_root"
  exit "$status"
}
trap cleanup EXIT
cp "$project_root/compose.yml" "$check_root/compose.yml"
mkdir -m 700 "$check_root/secrets"
openssl rand -hex 24 > "$check_root/secrets/s3_access_key"
openssl rand -hex 32 > "$check_root/secrets/s3_secret_key"
chmod 444 "$check_root/secrets/"*
docker compose -p "$check_project" -f "$check_root/compose.yml" up -d --pull never --wait --wait-timeout 180
export TAG_FILES_RELEASE_ORIGIN="http://127.0.0.1:$TAG_FILES_PORT"
printf 'Testing app=%s storage=%s origin=%s\n' "$TAG_FILES_APP_IMAGE" "$TAG_FILES_STORAGE_IMAGE" "$TAG_FILES_RELEASE_ORIGIN"
cd "$project_root/web"
npm exec playwright test -- --config playwright.release.config.ts
# Restart both exact images on their existing disposable volumes. No pulls or
# external network are used by these services after the build.
docker compose -p "$check_project" -f "$check_root/compose.yml" restart --timeout 120
docker compose -p "$check_project" -f "$check_root/compose.yml" up -d --pull never --wait --wait-timeout 180
python3 - <<'PY'
import json,os,urllib.request
base=os.environ['TAG_FILES_RELEASE_ORIGIN']
with urllib.request.urlopen(base+'/api/v1/items') as response:
    page=json.load(response)
    assert page['totalItems']==2,page
for item in page['items']:
    with urllib.request.urlopen(base+item['contentUrl']) as response:
        assert len(response.read())>32
with urllib.request.urlopen(base+'/content/1') as response:
    assert b'id="root"' in response.read()
print('Restart: both published primaries and SPA deep link verified')
PY
