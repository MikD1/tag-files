#!/usr/bin/env python3
"""Audit the files shipped in storage/backup images without starting services."""
import argparse
import hashlib
import json
from pathlib import Path, PurePosixPath
import subprocess
import tarfile
import tempfile

PREFIX = "usr/share/tag-files/notices/"


def audit(image, role):
    container = subprocess.check_output(["docker", "create", "--entrypoint", "/bin/true", image], text=True).strip()
    try:
        with tempfile.TemporaryDirectory(prefix="image-notices-") as temporary:
            root = Path(temporary)
            binaries = {"storage": ("usr/bin/weed", "usr/local/bin/storage-run", "usr/local/bin/storage-check"),
                        "backup": ("cold-backup",)}[role]
            runtime_files = {"bin/busybox", "lib/ld-musl-aarch64.so.1", "lib/ld-musl-x86_64.so.1", "etc/ssl/certs/ca-certificates.crt"} if role == "storage" else set()
            files = set()
            export = subprocess.Popen(["docker", "export", container], stdout=subprocess.PIPE)
            with tarfile.open(fileobj=export.stdout, mode="r|") as archive:
                for member in archive:
                    path = member.name.removeprefix("./")
                    if member.isfile() and (path.startswith(PREFIX) or path in binaries or path in runtime_files):
                        if PurePosixPath(path).is_absolute() or ".." in PurePosixPath(path).parts:
                            raise ValueError("unsafe notice/binary path in image")
                        files.add(path)
                        destination = root / path
                        destination.parent.mkdir(parents=True, exist_ok=True)
                        with archive.extractfile(member) as source, destination.open("wb") as target:
                            while chunk := source.read(1024 * 1024):
                                target.write(chunk)
            if export.wait() != 0:
                raise ValueError("image export failed")
            required = {PREFIX + "LICENSE", PREFIX + "GO-LICENSE"}
            required.add(PREFIX + ("upstream/seaweedfs/LICENSE" if role == "storage" else "musl/COPYRIGHT"))
            if role == "storage":
                required.update(PREFIX + "runtime/" + name for name in (
                    "BUSYBOX-LICENSE", "BUSYBOX-AUTHORS", "MUSL-COPYRIGHT", "CA-MPL-2.0", "CA-certdata.txt",
                    "CA-MIT.txt", "CA-c_rehash.c", "ca-certificates-20261020.tar.bz2",
                    "busybox-1.37.0.tar.bz2", "busybox-alpine-aports.tar.gz", "SOURCES.md", "SHA256SUMS",
                    "UTMPS-COPYING", "SKALIBS-COPYING", "utmps-0.1.3.2.tar.gz", "skalibs-2.14.5.0.tar.gz"))
                required.add(PREFIX + "upstream/seaweedfs/GO-LICENSE")
            else:
                required.update(PREFIX + name for name in ("COPYING3", "COPYING.RUNTIME", "static-link.map"))
            missing = required - files
            if missing:
                raise ValueError(image + ": missing shipped distribution texts: " + ", ".join(sorted(missing)))
            if any((root / path).stat().st_size < 1 for path in required):
                raise ValueError(image + ": empty distribution text")
            if role == "storage":
                for line in (root / PREFIX / "runtime/SHA256SUMS").read_text().splitlines():
                    expected, name = line.split("  ", 1)
                    if PurePosixPath(name).is_absolute() or ".." in PurePosixPath(name).parts or hashlib.file_digest((root / PREFIX / "runtime" / name).open("rb"), "sha256").hexdigest() != expected:
                        raise ValueError("preserved runtime license/source bytes changed")
                for line in (root / PREFIX / "runtime-files.sha256").read_text().splitlines():
                    expected, name = line.split("  ", 1)
                    name = name.removeprefix("/runtime/")
                    if name not in runtime_files or hashlib.file_digest((root / name).open("rb"), "sha256").hexdigest() != expected:
                        raise ValueError("runtime file differs from the pinned seed")
            for binary in binaries:
                info = json.loads(subprocess.check_output(["go", "version", "-m", "-json", str(root / binary)]))
                folder = "upstream/seaweedfs/go/" if binary == "usr/bin/weed" else "go/"
                inventory = (root / PREFIX / folder / "go-modules.txt").read_text().splitlines()
                included = {tuple(line.split()[:2]) for line in inventory if line.strip()}
                expected = {(dep["Path"], dep["Version"]) for dep in info.get("Deps", [])}
                # Storage's two executables share one dependency inventory.
                if not expected <= included:
                    raise ValueError(binary + ": dependency notices missing: " + repr(expected - included))
                for path, version in expected:
                    directory = root / PREFIX / folder / "modules" / (path + "@" + version)
                    if not any(entry.is_file() for entry in directory.rglob("*")):
                        raise ValueError(binary + ": empty notice directory: " + path)
                print(image + ": " + binary + ": " + str(len(expected)) + " actual Go dependencies covered")
            print(image + ": " + str(sum(path.startswith(PREFIX) for path in files)) + " notice/inventory files")
            if role == "storage":
                # Export alone cannot see an unused executable removed by a
                # later layer. Inspect every distributed Docker layer as well.
                saved = root / "image.tar"
                subprocess.run(["docker", "image", "save", "--output", str(saved), image], check=True)
                with tarfile.open(saved, "r:*") as outer:
                    manifest = json.load(outer.extractfile("manifest.json"))
                    for layer in {path for entry in manifest for path in entry["Layers"]}:
                        with tarfile.open(fileobj=outer.extractfile(layer), mode="r|*") as inner:
                            for member in inner:
                                if member.isfile() and Path(member.name).name in {"weed-volume", "weed-worker", "weed-vector"}:
                                    raise ValueError("unused Rust executable remains in a distributed layer")
                print(image + ": all distributed layers exclude unused Rust executables")
    finally:
        subprocess.run(["docker", "rm", "--volumes", container], check=True, stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("role", choices=("storage", "backup"))
    parser.add_argument("image")
    args = parser.parse_args()
    audit(args.image, args.role)
