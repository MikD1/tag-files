#!/usr/bin/env bash
set -euo pipefail
project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$project_root/tools/codegen"
go tool sqlc generate -f "$project_root/app/sqlc.yaml"
go tool oapi-codegen --config "$project_root/api/oapi-codegen.yaml" "$project_root/api/openapi.yaml"
npm run generate --silent
