#!/usr/bin/env python3
"""Exercise already-built images with no service route outside owned networks."""
import hashlib
import http.client
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import secrets
import shutil
import subprocess
import tempfile
import threading
import time
import urllib.request

ROOT = Path(__file__).resolve().parent.parent


def loopback_proxy(target):
    # Keep the browser's normal trusted localhost origin. Docker's internal
    # networks suppress published ports; only this host process can reach the
    # private app IP. Request and response bodies use bounded streaming buffers.
    class Proxy(BaseHTTPRequestHandler):
        def log_message(self, *_args):
            pass

        def forward(self):
            connection = http.client.HTTPConnection(target, 8080, timeout=90)
            excluded = {"connection", "keep-alive", "proxy-connection", "transfer-encoding", "te", "trailer", "upgrade"}
            try:
                if self.headers.get("Transfer-Encoding"):
                    self.send_error(400, "Fixture requires an explicit Content-Length")
                    return
                connection.putrequest(self.command, self.path, skip_host=True, skip_accept_encoding=True)
                for key, value in self.headers.items():
                    if key.lower() not in excluded:
                        connection.putheader(key, value)
                connection.endheaders()
                remaining = int(self.headers.get("Content-Length", "0"))
                while remaining:
                    chunk = self.rfile.read(min(64 * 1024, remaining))
                    if not chunk:
                        raise ConnectionError("Incomplete fixture request body")
                    connection.send(chunk)
                    remaining -= len(chunk)
                response = connection.getresponse()
                self.send_response(response.status, response.reason)
                for key, value in response.getheaders():
                    if key.lower() not in excluded:
                        self.send_header(key, value)
                self.end_headers()
                if self.command != "HEAD":
                    while chunk := response.read(64 * 1024):
                        self.wfile.write(chunk)
            except (BrokenPipeError, ConnectionResetError):
                pass  # Browser navigation may cancel an in-flight response.
            finally:
                connection.close()
                self.close_connection = True

        do_GET = do_HEAD = do_POST = do_PUT = do_PATCH = do_DELETE = forward

    server = ThreadingHTTPServer(("127.0.0.1", 0), Proxy)
    server.daemon_threads = True
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    return server, thread


def capture(args, **kwargs):
    return subprocess.check_output(args, text=True, **kwargs).strip()


def main():
    work = Path(tempfile.mkdtemp(prefix=".performance.offline-", dir=ROOT))
    project = "tag-files-offline-" + secrets.token_hex(6)
    report = {"project": project, "sourceHEAD": capture(["git", "rev-parse", "HEAD"], cwd=ROOT),
              "startedUTC": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "result": "failed"}
    compose = ["docker", "compose", "-p", project, "-f", str(work / "compose.json")]
    proxy = thread = None
    print(f"Offline image fixture: {work}", flush=True)
    try:
        identities = {}
        for role, fallback in (("app", "tag-files-app:local"), ("storage", "tag-files-storage:local-check")):
            ref = os.environ.get(f"TAG_FILES_OFFLINE_{role.upper()}_IMAGE", fallback)
            meta = json.loads(capture(["docker", "image", "inspect", ref]))[0]
            identities[role] = meta["Id"]
            report[role] = {key: meta.get(key) for key in ("Id", "Architecture", "Os", "Config")}
        env = {**os.environ, "TAG_FILES_APP_IMAGE": identities["app"], "TAG_FILES_STORAGE_IMAGE": identities["storage"]}
        (work / "secrets").mkdir(mode=0o700)
        for name in ("s3_access_key", "s3_secret_key"):
            path = work / "secrets" / name
            path.write_text(secrets.token_hex(32) + "\n")
            path.chmod(0o444)
        shutil.copyfile(ROOT / "compose.yml", work / "production.yml")
        config = json.loads(capture(["docker", "compose", "-f", str(work / "production.yml"), "config", "--format", "json"], env=env))
        config["networks"]["frontend"]["internal"] = True
        for name, network in config["networks"].items():
            network["name"] = f"{project}_{name}"
        for name, volume in config["volumes"].items():
            volume["name"] = f"{project}_{name}"
        config["services"]["app"]["ports"] = []
        (work / "compose.json").write_text(json.dumps(config, indent=2) + "\n")

        def run(arguments, log=None, cwd=ROOT):
            with (work / log).open("w") if log else open(os.devnull, "w") as stream:
                subprocess.run(arguments, cwd=cwd, env=env, check=True, timeout=600,
                               stdout=stream, stderr=subprocess.STDOUT)

        run(compose + ["up", "-d", "--pull", "never", "--wait", "--wait-timeout", "180"], "startup.log")
        containers = {}
        for role in identities:
            container = capture(compose + ["ps", "-q", role], env=env)
            meta = json.loads(capture(["docker", "inspect", container]))[0]
            assert meta["Image"] == identities[role]
            assert not meta["HostConfig"].get("PortBindings"), "offline fixture must publish no ports"
            routes = capture(["docker", "exec", container, "cat", "/proc/net/route"])
            for row in routes.splitlines()[1:]:
                fields = row.split()
                assert fields[1] != "00000000" or fields[7] != "00000000", "service has a default route"
            networks = meta["NetworkSettings"]["Networks"]
            expected = {f"{project}_library"}
            if role == "app":
                expected.add(f"{project}_frontend")
            assert set(networks) == expected, networks
            for network in networks:
                info = json.loads(capture(["docker", "network", "inspect", network]))[0]
                assert info["Internal"] and not info["EnableIPv6"], info
            containers[role] = {"id": container, "image": meta["Image"], "routes": routes,
                                "networks": networks, "publishedPorts": meta["HostConfig"].get("PortBindings")}
        report["isolation"] = containers
        app_ip = containers["app"]["networks"][f"{project}_frontend"]["IPAddress"]
        proxy, thread = loopback_proxy(app_ip)
        origin = f"http://127.0.0.1:{proxy.server_port}"
        report["browserOrigin"] = origin
        report["forwarding"] = {"hostBind": "127.0.0.1", "target": f"{app_ip}:8080", "bufferBytes": 65536}
        env.update(TAG_FILES_RELEASE_ORIGIN=origin, TAG_FILES_RELEASE_EXPECT_SINGLE_ORIGIN="1")
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))

        def request(path):
            with opener.open(origin + path, timeout=30) as response:
                return response.read()

        assert json.loads(request("/api/v1/items"))["totalItems"] == 0
        run(["npm", "exec", "playwright", "test", "--", "--config", "playwright.release.config.ts",
             "--output", str(work / "browser")], "browser.log", ROOT / "web")
        before = json.loads(request("/api/v1/items"))
        assert before["totalItems"] == 2
        primary = (ROOT / "app/internal/media/testdata/quadrants.png").read_bytes()
        hashes = {}
        for row in before["items"]:
            data = request(row["contentUrl"])
            assert data == primary
            hashes[str(row["id"])] = hashlib.sha256(data).hexdigest()
        run(compose + ["restart", "--timeout", "120"], "restart.log")
        run(compose + ["up", "-d", "--pull", "never", "--wait", "--wait-timeout", "180"], "readiness.log")
        assert json.loads(request("/api/v1/items")) == before
        for row in before["items"]:
            assert hashlib.sha256(request(row["contentUrl"])).hexdigest() == hashes[str(row["id"])]
        assert b'id="root"' in request("/content/1")
        with opener.open(origin + "/health/ready", timeout=30) as response:
            assert response.status == 200
        env["TAG_FILES_OFFLINE_OUTPUT"] = str(work)
        run(["node", "scripts/check-offline-viewer.mjs"], "viewer.log", ROOT / "web")
        report.update(result="passed", primaryHashes=hashes, browser="Chromium and WebKit, expanded real upload/editor cases with single-origin request assertion")
        print("Offline image browser/upload/editor/restart checks passed", flush=True)
    finally:
        (work / "report.json").write_text(json.dumps(report, indent=2) + "\n")
        if proxy:
            proxy.shutdown()
            proxy.server_close()
            thread.join(timeout=5)
        try:
            if (work / "compose.json").exists():
                try:
                    with (work / "runtime.log").open("w") as stream:
                        subprocess.run(compose + ["logs", "--no-color"], env=env, stdout=stream, stderr=subprocess.STDOUT, timeout=30)
                finally:
                    subprocess.run(compose + ["down", "--volumes", "--remove-orphans", "--timeout", "120"], env=env, check=True, timeout=300)
        finally:
            shutil.rmtree(work / "secrets", ignore_errors=True)
        remaining = {kind: capture(["docker", kind, "ls", "--filter", f"label=com.docker.compose.project={project}", "-q"]).splitlines()
                     for kind in ("container", "network", "volume")}
        assert not any(remaining.values()), remaining
        (work / "cleanup.json").write_text(json.dumps({"project": project, "remaining": remaining}) + "\n")


if __name__ == "__main__":
    main()
