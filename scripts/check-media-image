#!/usr/bin/env bash
set -euo pipefail
project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
media_image="tag-files-media:local-check"
docker build --progress=plain --target media-check -f "$project_root/deploy/app/Dockerfile" -t "$media_image" "$project_root"
media_ref=$(docker image inspect --format '{{.Id}}' "$media_image")
media_container=""
cleanup() {
  if [[ -n "$media_container" ]]; then docker rm -f -- "$media_container" >/dev/null 2>&1 || true; fi
}
trap cleanup EXIT
for media_test in media-test process-test; do
  media_container="tag-files-media-check-$(cat /proc/sys/kernel/random/uuid)"
  docker run --rm --name "$media_container" --network none --read-only \
    --tmpfs /scratch:rw,nosuid,nodev,noexec,size=268435456,uid=10001,gid=10001 \
    -e TAG_FILES_MEDIA_INTEGRATION=1 "$media_ref" "/usr/local/bin/$media_test" -test.v -test.timeout=2m
  media_container=""
done
