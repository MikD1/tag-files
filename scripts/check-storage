#!/usr/bin/env bash
set -euo pipefail
project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
storage_image='chrislusf/seaweedfs:4.53@sha256:ccad23e18639c8b98cee17e7100b95830a06077b56d8e5b006d6dcf8ec5e94a0'
docker info >/dev/null
if ! docker image inspect "$storage_image" >/dev/null 2>&1; then
  echo "Pull the pinned test image first: docker pull $storage_image" >&2
  exit 1
fi
cd "$project_root/app"
TAG_FILES_INTEGRATION=1 go test -race ./internal/objectstore ./internal/storageprofile -count=1 -v
