#!/usr/bin/env bash
set -euo pipefail
project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
check_tmp=$(mktemp -d)
trap 'rm -rf -- "$check_tmp"' EXIT

# Compare to the working tree so a dirty generated file cannot hide behind a
# committed baseline. Generators are pinned in their own module.
cp -R "$project_root/app/internal/store/dbgen" "$check_tmp/dbgen"
cp "$project_root/app/internal/httpapi/api/api.gen.go" "$check_tmp/api.gen.go"
cp "$project_root/web/src/api/schema.d.ts" "$check_tmp/schema.d.ts"
"$project_root/scripts/generate"
diff -ru "$check_tmp/dbgen" "$project_root/app/internal/store/dbgen"
diff -u "$check_tmp/api.gen.go" "$project_root/app/internal/httpapi/api/api.gen.go"
diff -u "$check_tmp/schema.d.ts" "$project_root/web/src/api/schema.d.ts"
cd "$project_root/app"
unformatted=$(gofmt -l .)
if [[ -n "$unformatted" ]]; then
  echo "Go files require gofmt:" >&2
  echo "$unformatted" >&2
  exit 1
fi
go vet ./...
go test ./...
go test -race ./...
for tool_module in "$project_root/tools/migrate" "$project_root/tools/backup"; do
  cd "$tool_module"
  unformatted=$(gofmt -l .)
  if [[ -n "$unformatted" ]]; then
    echo "Go files require gofmt:" >&2
    echo "$unformatted" >&2
    exit 1
  fi
  go vet ./...
  go test -race ./...
done
python3 -m unittest discover -s "$project_root/tools/backup" -p '*_test.py'
python3 -m unittest discover -s "$project_root/scripts" -p 'test_install_update.py'
python3 -m unittest discover -s "$project_root/scripts" -p 'test_release_images.py'
python3 -m unittest discover -s "$project_root/scripts" -p 'test_setup.py'
python3 -m unittest discover -s "$project_root/scripts" -p 'test_host_data.py'
python3 -m unittest discover -s "$project_root/scripts" -p 'test_collect_go_notices.py'
"$project_root/scripts/check-web"
